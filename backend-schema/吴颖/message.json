{
  "基本信息": {                     // 消息本身的属性，一条消息只存一份
    "id": "string",                 // 消息唯一ID，格式 msg_ + 随机串，供账号侧引用
    "title": "string",              // 标题，列表页显示的第一行；管理员填写，周报由 Agent 生成
    "content": "string",            // 正文，消息的完整内容；活动报名链接直接写在这里，不走附件
  },
  "发送与接收": {                   // 谁发的、什么时候发的、发给谁
    "sender_id": "string",          // 发送人ID，指向 adminAccount.id或者是agent.id，用于列表显示来源与追溯（需要跟“管理员”实体的字段对齐！）(给agent留个身份)
    "sent_at": "number",            // 发送时间戳，列表按此倒序排列，也用于全部/今天/本周筛选（时间戳单位需要统一！）
  }
}
