{
  "基本信息": {                     // 待办自身的属性，一条待办只属于一个人
    "id": "string",                 // 待办唯一ID，格式 todo_ + 随机串，供账号侧待办数组引用
    "account_id": "string",         // 所属人ID，指向 account.id；助教与管理员同样有自己的待办，不限于学员（与“人”实体的id字段对齐！）
    "content": "string",            // 待办内容，一句话说明要做什么，前端直接展示
    "done": "boolean"               // 是否完成，决定前端勾选状态与计划完成度；有 task_id 时以学习任务状态为准
  },
  "关联信息": {                     // 与学习任务的关联，无关联时留空串
    "task_id": "string"             // 关联的学习任务ID，为空表示普通待办；学习任务完成时按此字段同步待办状态（需要跟“人”主体的是否通过课程字段对齐！）
  }
}
